{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-game6",
  "main": "./worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/game-ws",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "Arena"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Arena"
      ]
    }
  ]
}
